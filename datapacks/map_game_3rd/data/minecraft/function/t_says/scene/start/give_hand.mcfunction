## 手持类任务的物品（id 50..52）
execute if score t_says.scene board matches 50 as @a[team=t_says,gamemode=adventure] run give @s wooden_sword 1
execute if score t_says.scene board matches 51 as @a[team=t_says,gamemode=adventure] run give @s diamond_sword 1
execute if score t_says.scene board matches 52 as @a[team=t_says,gamemode=adventure] run give @s shield 1
