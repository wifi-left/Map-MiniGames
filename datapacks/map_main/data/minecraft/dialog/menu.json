{
    "type": "minecraft:multi_action",
    "title": "MiniGames 小游戏菜单",
    "columns": 1,
    "actions": [
        {
            "label": "地图介绍",
            "action": {
                "type": "show_dialog",
                "dialog": "minecraft:map_credit"
            }
        },
        {
            "label": "快捷开始游戏 (仅大厅)",
            "action": {
                "type": "minecraft:run_command",
                "command": "/trigger quickplay set -1"
            }
        },
        {
            "label": "全局旁观操作菜单",
            "action": {
                "type": "show_dialog",
                "dialog":"minecraft:spectator_menu"
            }
        },
        {
            "label": "地图背景音乐设置",
            "action": {
                "type": "show_dialog",
                "dialog": {
                    "columns": 1,
                    "pause": false,
                    "type": "minecraft:multi_action",
                    "title": "地图背景音乐设置",
                    "body": [
                        {
                            "type": "minecraft:plain_message",
                            "contents": [
                                {
                                    "text": "启用或者禁用地图音乐。\n您也可以关闭声音选项中的"
                                },
                                {
                                    "translate": "soundCategory.voice"
                                },
                                {
                                    "text": "来调整音乐声音大小。"
                                }
                            ]
                        }
                    ],
                    "actions": [
                        {
                            "label": {
                                "text": "启用地图背景音乐",
                                "color": "green"
                            },
                            "action": {
                                "type": "run_command",
                                "command": "/trigger music_trigger set 1"
                            }
                        },
                        {
                            "label": {
                                "text": "禁用地图背景音乐",
                                "color": "red"
                            },
                            "action": {
                                "type": "run_command",
                                "command": "/trigger music_trigger set 2"
                            }
                        },
                        {
                            "label": "返回",
                            "action": {
                                "type": "show_dialog",
                                "dialog": "minecraft:menu"
                            }
                        }
                    ],
                    "exit_action": {
                        "label": "关闭"
                    }
                }
            }
        },
        {
            "label": "返回大厅 (/trigger hub)",
            "action": {
                "type": "minecraft:run_command",
                "command": "/trigger hub"
            }
        }
    ],
    "can_close_with_escape": true,
    "external_title": {
        "text": "小游戏快捷菜单",
        "color": "aqua",
        "bold": true
    },
    "pause": false,
    "body": {
        "type": "minecraft:plain_message",
        "contents": [
            {
                "text": "欢迎游玩 ",
                "color": "aqua"
            },
            {
                "text": "wifi's ",
                "color": "gold"
            },
            {
                "text": "Mini",
                "color": "green"
            },
            {
                "text": "Games",
                "color": "yellow"
            },
            {
                "text": "\n"
            }
        ]
    },
    "exit_action": {
        "label": "关闭"
    }
}