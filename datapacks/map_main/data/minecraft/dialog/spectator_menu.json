{
    "pause": false,
    "columns": 1,
    "type": "minecraft:multi_action",
    "title": "全局旁观操作菜单",
    "body": [
        {
            "type": "minecraft:plain_message",
            "contents": [
                {
                    "text": "全局旁观操作菜单，可以开启全局旁观者，可以更加方便录制视频等。"
                }
            ]
        }
    ],
    "actions": [
        {
            "label": "启用全局旁观者",
            "action": {
                "type": "run_command",
                "command": "/trigger spec set 2"
            }
        },
        {
            "label": "关闭全局旁观者",
            "action": {
                "type": "run_command",
                "command": "/trigger spec set 3"
            }
        },
        {
            "label": "开启旁观模式（仅在旁观模式下）",
            "action": {
                "type": "run_command",
                "command": "/trigger spec set 4"
            }
        },
        {
            "label": "返回",
            "action": {
                "type": "show_dialog",
                "dialog": "minecraft:menu"
            }
        }
    ],
    "exit_action": {
        "label": "关闭"
    }
}